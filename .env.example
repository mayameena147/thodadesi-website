# Copy to .env for local development with `netlify dev`.
# In production these live in Netlify: Site configuration → Environment variables.
#
# NONE of these may ever be committed or shipped to the browser, except
# RAZORPAY_KEY_ID and SUPABASE_ANON_KEY, which are public by design and are
# handed out deliberately by the functions.

# Razorpay → Settings → API Keys. Use rzp_test_* keys until the whole flow
# is verified, then swap to rzp_live_* here and NOWHERE else.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay → Settings → Webhooks. A DIFFERENT secret from the API key: you
# choose this string yourself when creating the webhook.
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# The public (anon) key — safe in a browser, governed by row-level security.
SUPABASE_ANON_KEY=eyJhbGciOi...
# The service_role key — bypasses row-level security. Server-side ONLY.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
